{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": [
        "model_api.py",
        "vercel_artifacts/features.json.gz",
        "vercel_artifacts/rf_forest.json.gz",
        "vercel_artifacts/rf_importances.json.gz",
        "vercel_artifacts/rf_threshold.json.gz",
        "vercel_artifacts/sample_input.json.gz"
      ],
      "excludeFiles": [
        "node_modules/**",
        "dist/**",
        "src/**",
        "vite/**",
        "public/**",
        ".git/**",
        ".insforge/**",
        "skills/**",
        "__pycache__/**",
        ".wrangler/**",
        "saved_models/**",
        "vercel_artifacts/**",
        "*.md",
        "*.lock",
        "worker-configuration.d.ts",
        "wrangler.json",
        "drizzle.config.ts",
        "tsconfig*.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
